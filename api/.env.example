PORT=5100
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/nest-transport
JWT_SECRET=  # generate: openssl rand -hex 32
JWT_REFRESH_SECRET=  # generate a different one
ALLOWED_ORIGINS=http://localhost:5175
# GPS ingestion: devices authenticate with a per-device key stored on the Device record

# --- Notification channels (all optional; a channel stays off until its variables are set AND an admin enables it) ---
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# File storage root for uploaded documents (back this up with the database)
UPLOAD_DIR=

# Public URL of the web app, used in invitation / password-reset links (defaults to the first ALLOWED_ORIGINS entry)
APP_URL=http://localhost:5175

# --- Online fee payments (optional) ---
# Razorpay: KEY_ID is sent to the browser; KEY_SECRET and WEBHOOK_SECRET never leave the server.
# Webhook URL to register in the Razorpay dashboard: https://<your-api-host>/api/v1/billing/razorpay/webhook (event: payment.captured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Sign-in OTP (WhatsApp) ---
# Platform number + approved AUTHENTICATION template with one {{1}} body variable (copy-code button unless HAS_BUTTON=false).
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=user_otp
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_OTP_HAS_BUTTON=true

# Platform subscription (what an organization pays Nest). Prices are integer paise per vehicle per month, GST extra.
# PRICE_BASIC_PAISE=15000
# PRICE_PRO_PAISE=25000
# TRIAL_DAYS=30
# TRIAL_VEHICLES=10

PORT=5100
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/nest-transport
JWT_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-too-long-random
ALLOWED_ORIGINS=http://localhost:5175
# GPS ingestion: devices authenticate with a per-device key stored on the Device record

# --- Notification channels (all optional; a channel stays off until its variables are set AND an admin enables it) ---
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# File storage root for uploaded documents (back this up with the database)
UPLOAD_DIR=
